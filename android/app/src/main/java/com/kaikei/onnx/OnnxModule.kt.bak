class OnnxModule(reactContext: ReactApplicationContext) : ReactContextBaseJavaModule(reactContext) {
    // ... (all properties are the same)
    private val ctx = reactContext
    private var env: OrtEnvironment? = null
    private var session: OrtSession? = null
    private val TAG = "OnnxModule"

    // ... (companion object is the same)
    companion object {
        const val SAMPLE_RATE: Int = 16000
        const val N_FFT: Int = 400
        const val HOP_LENGTH: Int = 160
        const val N_MELS: Int = 80
        const val N_FRAMES: Int = 3000 // 30 seconds * 100 frames/sec
        const val TOKEN_SOT: Long = 50258
        const val TOKEN_SW: Long = 50327
        const val TOKEN_EN: Long = 50259
        const val TOKEN_TRANSCRIBE: Long = 50359
        const val TOKEN_NOTIMESTAMPS: Long = 50363
    }


    // ... (getName, copyAssetToFile, loadModel are all correct from your file)
    override fun getName(): String = "OnnxModule"

    // copyAssetToFile (Unchanged)
    private fun copyAssetToFile(assetPath: String, destFile: File) {
        Log.d(TAG, "Copying asset: $assetPath to $destFile")
        val assetManager: AssetManager = ctx.assets
        assetManager.open(assetPath).use { input ->
            FileOutputStream(destFile).use { out ->
                input.copyTo(out)
            }
        }
        Log.d(TAG, "Asset copy complete.")
    }

    // loadModel (Unchanged)
    @ReactMethod
    fun loadModel(promise: Promise) {
        thread {
            try {
                Log.d(TAG, "loadModel: Loading ONNX environment...")
                if (env == null) env = OrtEnvironment.getEnvironment()
                
                val modelFilename = "whisper-base-sw-quantized.onnx"
                val outFile = File(ctx.filesDir, modelFilename)
                
                if (!outFile.exists()) {
                    Log.d(TAG, "loadModel: Model file not found, copying from assets...")
                    copyAssetToFile("models/$modelFilename", outFile)
                } else {
                    Log.d(TAG, "loadModel: Model file already exists.")
                }

                val opts = OrtSession.SessionOptions()
                opts.setOptimizationLevel(OrtSession.SessionOptions.OptLevel.BASIC_OPT)
                
                session?.close()
                Log.d(TAG, "loadModel: Creating new ONNX session...")
                session = env!!.createSession(outFile.absolutePath, opts)
                Log.i(TAG, "loadModel: Model loaded successfully.")
                promise.resolve("model_loaded")
            } catch (e: Exception) {
                Log.e(TAG, "loadModel error", e)
                promise.reject("LOAD_ERROR", e.message)
            }
        }
    }

